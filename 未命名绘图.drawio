        <mxCell id="X5wu8MR4ORQ3O4vnwKrm-239" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;反馈与推动标准化文档输出&lt;/font&gt;" vertex="1">
          <mxGeometry height="141" width="643" x="177" y="4468" as="geometry" />
